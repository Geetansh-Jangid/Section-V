# ==============================================================================
# SECTION V: ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ==============================================================================

# GitHub Personal Access Token (PAT) used by the server to create branches & PRs
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# GitHub Repository to submit PRs to (owner/repo)
GITHUB_REPO=Geetansh-Jangid/Section-V

# Base branch to open Pull Requests against
GITHUB_BASE_BRANCH=v2
